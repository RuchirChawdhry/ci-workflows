---
import BaseLayout from '../layouts/BaseLayout.astro';
import { workflows, repository, workflowUrl } from '../data/workflows';

const flowCount = String(workflows.length).padStart(2, '0');
---
<BaseLayout>
  <div class="site-shell" id="top">
    <div class="ambient ambient-a" aria-hidden="true"></div>
    <div class="ambient ambient-b" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container nav-inner">
        <a class="brand" href="#top" aria-label="ci-workflows home">
          <svg class="brand-mark" viewBox="0 0 44 44" fill="none" aria-hidden="true">
            <path d="M5 22 17 10l12 12-12 12Z" stroke="#50E9C8" stroke-width="3" stroke-linejoin="round"/>
            <path d="m17 31 11-11 11 11-11 11Z" stroke="#AC8CFF" stroke-width="3" stroke-linejoin="round"/>
            <circle cx="34" cy="8" r="3" fill="#F6B56F"/>
          </svg>
          <span class="brand-type">ci<span class="brand-hyphen">-</span>workflows</span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="#workflows">Workflows</a>
          <a href="#how-it-works">How it works</a>
          <a href="#principles">Philosophy</a>
        </nav>
        <a class="header-github" href={repository} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.64c.56.1.76-.24.76-.54v-2.11c-3.09.68-3.74-1.31-3.74-1.31-.5-1.28-1.24-1.63-1.24-1.01-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 . 1.71 2.62 1.22 3.26.94.1-.72.4-1.22.72-1.5-2.47-.28-5.07-1.23-5.07-5.49 0-1.21.43-2.2 1.15-2.98-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.14A10.5 10.5 0 0 1 12 6.08c.95 0 1.9.13 2.79.38 2.11-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.11 2.95.71.78 1.14 1.77 1.14 2.98 0 4.27-2.61 5.2-5.09 5.48.42.37.8 1.08.8 2.18V22c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
          <span>GitHub</span><span class="northeast" aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <div class="hero-left">
          <div class="eyebrow-pill"><span class="live-indicator"></span> OPEN-SOURCE AUTOMATION TOOLKIT <span class="pill-spark">✳</span></div>
          <h1 id="hero-title">Less YAML.<br/><span class="gradient-text">More building.</span></h1>
          <p class="hero-description">One thoughtfully engineered home for the workflows every project needs. Test, package, validate and deploy without reinventing the pipeline.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#workflows"><span>Explore workflows</span><span aria-hidden="true">↗</span></a>
            <a class="button button-outline" href={repository} target="_blank" rel="noopener noreferrer"><span>View on GitHub</span><span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero-footnote"><span class="footnote-symbol">✦</span> Modular by design. Built to be reused.</div>
        </div>
        <div class="hero-right">
          <div class="hero-glow" aria-hidden="true"></div>
          <div class="system-label label-one"><span class="tiny-led"></span> WORKFLOW ONLINE</div>
          <div class="terminal-card">
            <div class="terminal-bar">
              <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
              <span>.github/workflows/pages.yml</span>
              <span class="terminal-bar-tag">YAML</span>
            </div>
            <div class="terminal-code" aria-label="Example reusable workflow call">
              <div><span class="code-muted">01</span><span class="code-comment"># Your project, your rules</span></div>
              <div><span class="code-muted">02</span><span class="code-purple">jobs</span><span class="code-white">:</span></div>
              <div><span class="code-muted">03</span><span class="code-white">  website:</span></div>
              <div><span class="code-muted">04</span><span class="code-purple">    uses</span><span class="code-white">:</span></div>
              <div><span class="code-muted">05</span><span class="code-teal">      RuchirChawdhry/</span></div>
              <div><span class="code-muted">06</span><span class="code-teal">      ci-workflows/...</span></div>
              <div><span class="code-muted">07</span><span class="code-teal">      pages-astro.yml@main</span></div>
              <div><span class="code-muted">08</span><span class="code-purple">    with</span><span class="code-white">:</span></div>
              <div><span class="code-muted">09</span><span class="code-white">      site-path: </span><span class="code-orange">website</span></div>
            </div>
            <div class="terminal-status"><span class="status-check" aria-hidden="true">✓</span><span>Reusable by default</span><span class="terminal-status-right">READY TO BUILD</span></div>
          </div>
          <div class="float-card float-card-top" aria-hidden="true"><span>⌁</span><div><strong>compose</strong><small>small pieces, big possibilities</small></div></div>
          <div class="float-card float-card-bottom" aria-hidden="true"><div class="mini-symbol">↗</div><div><strong>build once</strong><small>reuse everywhere</small></div></div>
          <div class="orbit orbit-one" aria-hidden="true"></div>
        </div>
      </section>
      <section class="proof-strip" aria-label="Project highlights">
        <div class="container proof-inner">
          <div class="proof-item"><strong>{flowCount}<span class="proof-plus">+</span></strong><span>ready-to-use workflows</span></div>
          <span class="proof-divider"></span>
          <div class="proof-item"><strong>01</strong><span>central toolkit</span></div>
          <span class="proof-divider"></span>
          <div class="proof-item"><strong>∞</strong><span>projects to power</span></div>
          <div class="proof-note">NOT MORE CONFIG. <span>MORE MOMENTUM.</span></div>
        </div>
      </section>
      <section class="section workflows-section container" id="workflows" aria-labelledby="workflows-title">
        <div class="section-heading">
          <div>
            <div class="section-eyebrow"><span class="section-stroke"></span> THE TOOLKIT <span class="eyebrow-index">/ 001</span></div>
            <h2 id="workflows-title">Everything connects.<br/><span class="muted-heading">Nothing gets in your way.</span></h2>
          </div>
          <p>Pick a complete workflow or combine smaller actions. Each piece is designed to solve one problem well.</p>
        </div>
        <div class="workflow-grid">
          {workflows.map((workflow) => (
            <a class={'workflow-card workflow-' + workflow.className} href={workflowUrl(workflow.path)} target="_blank" rel="noopener noreferrer" aria-label={'View ' + workflow.title + ' reusable workflow on GitHub'}>
              <div class="workflow-card-head"><span class="workflow-index">{workflow.eyebrow}</span><span class="workflow-arrow" aria-hidden="true">↗</span></div>
              <div class="workflow-emoji" aria-hidden="true">{workflow.icon}</div>
              <h3>{workflow.title}</h3>
              <p>{workflow.description}</p>
              <div class="workflow-card-foot"><span class="category-pill">{workflow.label}</span><span class="file-name">{workflow.path}</span></div>
            </a>
          ))}
          <div class="workflow-card workflow-more">
            <div class="more-graphic" aria-hidden="true"><span>+</span><span>+</span><span>+</span></div>
            <span class="more-eyebrow">ALWAYS EVOLVING</span>
            <h3>Made to grow<br/>with your projects.</h3>
            <p>One more reusable building block beats another copied pipeline.</p>
            <a href={repository + '/tree/main/actions'} target="_blank" rel="noopener noreferrer">Explore composite actions <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
      <section class="section how-section" id="how-it-works" aria-labelledby="how-title">
        <div class="container how-container">
          <div class="section-eyebrow"><span class="section-stroke"></span> HOW IT WORKS <span class="eyebrow-index">/ 002</span></div>
          <div class="how-head"><h2 id="how-title">Your workflow.<br/><span class="gradient-text">Without the busywork.</span></h2><p>Stay in control of your project. Let the shared library handle the repeatable parts.</p></div>
          <div class="steps">
            <article class="step"><div class="step-num">01<span>↗</span></div><div class="step-line"></div><h3>Choose a building block</h3><p>Find the quality check, packaging workflow, or deployment step you need.</p></article>
            <article class="step"><div class="step-num">02<span>↗</span></div><div class="step-line"></div><h3>Call it in your repository</h3><p>Keep a tiny caller workflow. Pin a reviewed version of the shared implementation.</p></article>
            <article class="step"><div class="step-num">03<span>✓</span></div><div class="step-line"></div><h3>Ship with confidence</h3><p>Each project retains its own triggers and permissions. Reuse the machinery, not the maintenance.</p></article>
          </div>
          <a class="text-link" href={repository + '/tree/main/docs'} target="_blank" rel="noopener noreferrer">Explore the documentation <span aria-hidden="true">↗</span></a>
        </div>
      </section>
      <section class="section principles-section container" id="principles" aria-labelledby="principles-title">
        <div class="principles-panel">
          <div class="principles-orb" aria-hidden="true"></div>
          <div class="principles-content">
            <div class="section-eyebrow"><span class="section-stroke"></span> THE PHILOSOPHY <span class="eyebrow-index">/ 003</span></div>
            <h2 id="principles-title">Small tools.<br/>Big leverage<span class="period">.</span></h2>
            <p>CI/CD should be infrastructure you trust, not YAML you babysit. Keep the components focused, the boundaries explicit, and the door open for what comes next.</p>
            <div class="principle-tags"><span>Composable</span><span>Tested</span><span>Open source</span><span>MIT licensed</span></div>
          </div>
          <div class="principles-art" aria-hidden="true">
            <span class="principles-art-top">THE BUILDING BLOCKS</span>
            <div class="tile tile-a">◎<small>QUALITY</small></div>
            <div class="tile tile-b">◈<small>PACKAGE</small></div>
            <div class="tile tile-c">↗<small>SHIP</small></div>
            <span class="principles-art-bottom">LESS YAML / MORE BUILDING</span>
          </div>
        </div>
      </section>
      <section class="closing container" aria-labelledby="closing-title">
        <span class="closing-star" aria-hidden="true">✳</span>
        <div class="closing-eyebrow">READY WHEN YOU ARE</div>
        <h2 id="closing-title">Build something.<br/><span class="gradient-text">We'll handle the repeatable bits.</span></h2>
        <a class="button button-primary" href={repository} target="_blank" rel="noopener noreferrer">Explore on GitHub <span aria-hidden="true">↗</span></a>
      </section>
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand"><span class="footer-symbol">✳</span> ci-workflows <span class="footer-separator">/</span> Less YAML. More building.</div>
        <div class="footer-links"><a href={repository + '/blob/main/LICENSE'} target="_blank" rel="noopener noreferrer">MIT License</a><a href={repository + '/tree/main/docs'} target="_blank" rel="noopener noreferrer">Docs</a><a href={repository} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
      </div>
    </footer>
  </div>
</BaseLayout>
